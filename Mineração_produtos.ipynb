    "import warnings\n",
    "warnings.filterwarnings(\"ignore\", category=DeprecationWarning)\n",
    "\n",
    "# Vamos definir uma lista de itens dominantes para excluir da visualização das regras\n",
    "itens_para_excluir = {'leite integral', 'iogurte', 'salsicha', 'salsicha alemã'}\n",
    "\n",
    "# Filtrar regras que NÃO contenham esses produtos dominantes nem no antecedente e nem no consequente\n",
    "regras_filtradas = regras_ordenadas[\n",
    "    ~regras_ordenadas['antecedents'].apply(lambda x: any(item in itens_para_excluir for item in x)) &\n",
    "    ~regras_ordenadas['consequents'].apply(lambda x: any(item in itens_para_excluir for item in x))\n",
    "]\n",
    "\n",
    "print(\"--- OUTRAS ASSOCIAÇÕES DE PRODUTOS (SEM LEITE, IOGURTE OU SALSICHA) ---\")\n",
    "if not regras_filtradas.empty:\n",
    "    resultado_alternativo = regras_filtradas[['antecedents', 'consequents', 'support', 'confidence', 'lift']]\n",
    "    display(resultado_alternativo.head(10))\n",
    "else:\n",
    "    print(\"Nenhuma regra encontrada sem os itens dominantes. Vamos reduzir ligeiramente o suporte mínimo para encontrar mais variedade.\")"
