   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\", category=DeprecationWarning)\n",
    "\n",
    "import pandas as pd\n",
    "from mlxtend.preprocessing import TransactionEncoder\n",
    "from mlxtend.frequent_patterns import apriori, association_rules\n",
    "\n",
    "\n",
    "traducao_itens = {\n",
    "    'whole milk': 'leite integral',\n",
    "    'yogurt': 'iogurte',\n",
    "    'sausage': 'salsicha',\n",
    "    'soda': 'refrigerante',\n",
    "    'rolls/buns': 'pãezinhos',\n",
    "    'other vegetables': 'outros vegetais',\n",
    "    'citrus fruit': 'frutas cítricas',\n",
    "    'specialty chocolate': 'chocolate especial',\n",
    "    'tropical fruit': 'frutas tropicais',\n",
    "    'flour': 'farinha',\n",
    "    'beef': 'carne bovina',\n",
    "    'pastry': 'folhados/doces',\n",
    "    'root vegetables': 'vegetais de raiz',\n",
    "    'canned beer': 'cerveja em lata',\n",
    "    'bottled water': 'água engarrafada',\n",
    "    'bottled beer': 'cerveja de garrafa',\n",
    "    'shopping bags': 'sacolas de compras',\n",
    "    'brown bread': 'pão preto/integral',\n",
    "    'whipped/sour cream': 'creme de leite/chantilly',\n",
    "    'newspapers': 'jornais',\n",
    "    'domestic eggs': 'ovos caipiras',\n",
    "    'margarine': 'margarina',\n",
    "    'pip fruit': 'frutas de semente (maçã/pera)',\n",
    "    'fruit/vegetable juice': 'suco de fruta/vegetal',\n",
    "    'frankfurter': 'salsicha alemã',\n",
    "    'pork': 'carne de porco',\n",
    "    'curd': 'coalhada',\n",
    "    'rolls/buns': 'pãezinhos/bisnagas'\n",
    "}\n",
    "\n",
    "# Recarregar o dataset para garantir consistência\n",
    "df_raw = pd.read_csv('Groceries_dataset.csv')\n",
    "\n",
    "# Substituir os nomes dos produtos usando o dicionário (os não mapeados permanecerão iguais)\n",
    "df_raw['itemDescription'] = df_raw['itemDescription'].replace(traducao_itens)\n",
    "\n",
    "# Agrupar novamente em transações com os itens já traduzidos\n",
    "transacoes_groceries = df_raw.groupby(['Member_number', 'Date'])['itemDescription'].apply(list).tolist()\n",
    "transacoes_filtradas = [t for t in transacoes_groceries if len(t) >= 2]\n",
    "\n",
    "# One-Hot Encoding\n",
    "te = TransactionEncoder()\n",
    "te_ary = te.fit(transacoes_filtradas).transform(transacoes_filtradas)\n",
    "df_encoded = pd.DataFrame(te_ary, columns=te.columns_)\n",
    "\n",
    "# Apriori\n",
    "frequent_itemsets = apriori(df_encoded, min_support=0.001, use_colnames=True)\n",
    "regras = association_rules(frequent_itemsets, metric=\"lift\", min_threshold=1.0)\n",
    "\n",
    "# Se houver regras, formatar e mostrar as top 10 traduzidas\n",
    "if not regras.empty:\n",
    "    regras_ordenadas = regras.sort_values(by=['lift', 'confidence'], ascending=False)\n",
    "    print(\"\\n--- REGRAS DE ASSOCIAÇÃO DO GROCERIES (TRADUZIDAS) ---\")\n",
    "    resultado_final = regras_ordenadas[['antecedents', 'consequents', 'support', 'confidence', 'lift']]\n",
    "    print(resultado_final.head(10).to_string(index=False))\n",
    "else:\n",
    "    print(\"Nenhuma regra encontrada com a configuração atual.\")"
   ],
