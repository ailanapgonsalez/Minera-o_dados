   "source": [
    "# Caso queiramos explorar ainda mais fundo, vamos recalcular o Apriori com suporte menor e removendo os dominantes direto no dataset\n",
    "df_alternativo = df_raw[~df_raw['itemDescription'].isin(itens_para_excluir)]\n",
    "\n",
    "transacoes_alt = df_alternativo.groupby(['Member_number', 'Date'])['itemDescription'].apply(list).tolist()\n",
    "transacoes_alt_filtradas = [t for t in transacoes_alt if len(t) >= 2]\n",
    "\n",
    "te_alt = TransactionEncoder()\n",
    "te_ary_alt = te_alt.fit(transacoes_alt_filtradas).transform(transacoes_alt_filtradas)\n",
    "df_encoded_alt = pd.DataFrame(te_ary_alt, columns=te_alt.columns_)\n",
    "\n",
    "# Usando um suporte mínimo ligeiramente menor para capturar relações entre itens menos frequentes\n",
    "frequent_itemsets_alt = apriori(df_encoded_alt, min_support=0.0005, use_colnames=True)\n",
    "regras_alt = association_rules(frequent_itemsets_alt, metric=\"lift\", min_threshold=1.1)\n",
    "\n",
    "if not regras_alt.empty:\n",
    "    regras_alt_ordenadas = regras_alt.sort_values(by=['lift', 'confidence'], ascending=False)\n",
    "    print(\"\\n--- ASSOCIAÇÕES DE PRODUTOS ALTERNATIVOS (MIN SUPORTE: 0.0005) ---\")\n",
    "    display(regras_alt_ordenadas[['antecedents', 'consequents', 'support', 'confidence', 'lift']].head(10))\n",
    "else:\n",
    "    print(\"Sem regras adicionais encontradas.\")"
   ],
